{
  "name": "BCR Readiness Request Generator",
  "properties": {
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "OrgUrl": {
          "type": "String",
          "defaultValue": ""
        },
        "DefaultReadinessDueDays": {
          "type": "Int",
          "defaultValue": 10
        }
      },
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Day",
            "interval": 1,
            "schedule": {
              "hours": [
                7
              ],
              "minutes": [
                0
              ]
            }
          }
        }
      },
      "actions": {
        "Initialize_varOrgUrl": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "varOrgUrl",
                "type": "string",
                "value": "@{parameters('OrgUrl')}"
              }
            ]
          }
        },
        "Initialize_varWindowEnd": {
          "runAfter": {
            "Initialize_varOrgUrl": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "varWindowEnd",
                "type": "string",
                "value": "@{formatDateTime(addDays(utcNow(),30),'yyyy-MM-dd')}"
              }
            ]
          }
        },
        "List_Budgets": {
          "runAfter": {
            "Initialize_varWindowEnd": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "bcr_budgetlines",
              "$select": "bcr_budgetlineid,bcr_budgetcode,bcr_enddate,bcr_smeemail,statecode,statuscode,_ownerid_value,bcr_pillar",
              "$filter": "statecode eq 0 and statuscode eq 1 and bcr_smeemail ne null and bcr_enddate le @{variables('varWindowEnd')}"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Apply_to_each_Budget": {
          "foreach": "@outputs('List_Budgets')?['body/value']",
          "runAfter": {
            "List_Budgets": [
              "Succeeded"
            ]
          },
          "type": "Foreach",
          "actions": {
            "Condition_NoDuplicate": {
              "runAfter": {
                "List_ReadinessTasks_for_Budget": [
                  "Succeeded"
                ]
              },
              "type": "If",
              "expression": {
                "equals": [
                  "@length(outputs('List_ReadinessTasks_for_Budget')?['body/value'])",
                  0
                ]
              },
              "actions": {
                "Compose_RecordUrl": {
                  "runAfter": {
                    "Add_new_ReadinessTask": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@{concat(variables('varOrgUrl'), '/main.aspx?pagetype=entityrecord&etn=bcr_readinesstask&id=', outputs('Add_new_ReadinessTask')?['body/bcr_readinesstaskid'])}"
                },
                "Send_email_to_SME": {
                  "runAfter": {
                    "Compose_RecordUrl": [
                      "Succeeded"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_office365",
                      "operationId": "SendEmailV2",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                    },
                    "parameters": {
                      "emailMessage/To": "@{items('Apply_to_each_Budget')?['bcr_smeemail']}",
                      "emailMessage/Subject": "Readiness task created for budget @{items('Apply_to_each_Budget')?['bcr_budgetcode']}",
                      "emailMessage/Body": "<p>A readiness task has been created for your budget line.</p><p>Please <a href='@{outputs('Compose_RecordUrl')}'>open the task</a>, complete required fields, and submit for Pillar Lead validation.</p>",
                      "emailMessage/Importance": "Normal"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Add_new_ReadinessTask": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "CreateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "bcr_readinesstasks",
                      "item/bcr_tasktitle": "@{concat('SME Readiness - ', coalesce(items('Apply_to_each_Budget')?['bcr_budgetcode'],'(No Code)'))}",
                      "item/bcr_budgetline@odata.bind": "@{concat('/bcr_budgetlines(', items('Apply_to_each_Budget')?['bcr_budgetlineid'], ')')}",
                      "item/bcr_duedate": "@{formatDateTime(addDays(utcNow(), parameters('DefaultReadinessDueDays')),'yyyy-MM-dd')}",
                      "item/bcr_assignedto@odata.bind": "@{if(empty(items('Apply_to_each_Budget')?['_ownerid_value']), null, concat('/systemusers(', items('Apply_to_each_Budget')?['_ownerid_value'], ')'))}",
                      "item/bcr_status": 100000001
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              },
              "else": {
                "actions": {}
              }
            },
            "List_ReadinessTasks_for_Budget": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "bcr_readinesstasks",
                  "$select": "bcr_readinesstaskid,bcr_tasktitle,_bcr_budgetline_value,statecode",
                  "$filter": "_bcr_budgetline_value eq '@{items('Apply_to_each_Budget')?['bcr_budgetlineid']}' and statecode eq 0"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 1
            }
          }
        }
      }
    },
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "connectionName": "shared_commondataserviceforapps",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
        "tier": "NotSpecified",
        "apiName": "commondataserviceforapps"
      },
      "shared_office365": {
        "connectionName": "shared_office365",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_office365",
        "tier": "NotSpecified",
        "apiName": "office365"
      }
    }
  }
}
